# Canonical site URL (build-time). Set by CodeBuild in CI.
PUBLIC_SITE_URL=https://cynthia.jideola.com
# "true" while on the preview domain so search engines do not index it.
PUBLIC_NOINDEX=true
# Contact form endpoint (Lambda function URL). Empty = form falls back to mailto.
PUBLIC_FORM_ENDPOINT=
# "true" shows the under-construction dialog + banner. Set "false" at go-live.
PUBLIC_UNDER_CONSTRUCTION=true
