---
/**
 * Base layout: head/SEO, hreflang, JSON-LD, skip link, header, footer.
 * Pages pass `locale`, `pageKey` (for nav + hreflang) and SEO strings.
 */
import '../styles/global.css';
import type { Locale, PageKey } from '../config/site';
import { site, pathFor } from '../config/site';
import { t } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { locale: Locale; pageKey?: PageKey; title: string; description: string; noindex?: boolean; ogImage?: string }
const { locale, pageKey, title, description, noindex, ogImage = '/images/og-default.svg' } = Astro.props;
const T = t(locale);
const siteUrl = Astro.site ?? new URL('https://cynthia.jideola.com');
const canonical = new URL(Astro.url.pathname, siteUrl);
const fullTitle = pageKey === 'home' || !pageKey ? `${site.legalName} — ${T('brand.tagline')}` : `${title} | ${site.name}`;
const robots = (noindex ?? site.noindex) ? 'noindex, nofollow' : 'index, follow';
const alt = pageKey ? { en: new URL(pathFor(pageKey, 'en'), siteUrl), es: new URL(pathFor(pageKey, 'es'), siteUrl) } : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HealthAndBeautyBusiness'],
  name: site.legalName,
  description,
  url: siteUrl.href,
  telephone: '+1-' + site.phone,
  email: site.email,
  founder: { '@type': 'Person', name: site.founder },
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.postalCode, addressCountry: site.address.country },
  areaServed: 'Houston, TX',
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang={locale === 'es' ? 'es-US' : 'en-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    {alt && <link rel="alternate" hreflang="en" href={alt.en.href} />}
    {alt && <link rel="alternate" hreflang="es" href={alt.es.href} />}
    {alt && <link rel="alternate" hreflang="x-default" href={alt.en.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1B3A2A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content={locale === 'es' ? 'es_US' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{T('skip')}</a>
    <Header locale={locale} currentKey={pageKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
