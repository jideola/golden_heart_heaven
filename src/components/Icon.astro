const d = paths[name] ?? paths.sparkles;
---
<svg
  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size}
  fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
  class={cls} aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}
  set:html={(title ? `<title>${title}</title>` : '') + d}
/>
